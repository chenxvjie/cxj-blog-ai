# Configuration template only. Never commit real credentials.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Select an exact model identifier supported by the account before implementation.
DEEPSEEK_MODEL=deepseek-flash
# SiliconFlow hosted dense embedding.
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# Identify the underlying model independently of the provider-specific alias.
EMBEDDING_SOURCE_MODEL=BAAI/bge-m3
AI_INTERNAL_TOKEN=

# Runtime role: AI table DML + SELECT public.blog_post; never use superuser in production.
DATABASE_URL=
# Migration/seed only. Do not pass this administrative URL to the production API container.
DATABASE_ADMIN_URL=
PUBLIC_BLOG_URL=http://127.0.0.1:5173
MIN_SIMILARITY=0.45

INDEX_WORKER_ENABLED=true
