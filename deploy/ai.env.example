# Install as /opt/cxj-blog/deploy/.env.ai, root-owned 0600.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
AI_INTERNAL_TOKEN=
DATABASE_URL=postgresql://cxj_blog_ai:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/cxj_blog
PUBLIC_BLOG_URL=https://chenxujie-bolg.cn
MIN_SIMILARITY=0.45
INDEX_WORKER_ENABLED=true
